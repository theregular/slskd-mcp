{
  "name": "slskd-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local TypeScript MCP server for slskd connection status and Soulseek searches.",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "check:connection": "tsc && node --env-file-if-exists=.env dist/scripts/check-connection.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check": "eslint . --max-warnings 0 && prettier . --check && tsc && node --test dist/test/*.test.js",
    "check:search": "tsc && node --env-file-if-exists=.env dist/scripts/check-search.js",
    "check:lifecycle": "tsc && node --env-file-if-exists=.env dist/scripts/check-search-lifecycle.js",
    "check:browse": "tsc && node --env-file-if-exists=.env dist/scripts/check-browse.js",
    "check:download": "tsc && node --env-file-if-exists=.env dist/scripts/check-download.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
