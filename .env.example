# slskd base URL; omit /api/v0. Include a reverse-proxy prefix if applicable.
SLSKD_URL=http://127.0.0.1:5030
SLSKD_API_KEY=
# For a temporary smoke test, set this instead of an API key:
# SLSKD_BEARER_TOKEN=
SLSKD_TIMEOUT_MS=5000
# Peer browse/info deadline in milliseconds (100–120000).
SLSKD_PEER_TIMEOUT_MS=30000
